# LLM API Keys & Model Config
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-1.5-flash

# Twilio Telephony Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Application Configuration
DATABASE_URL=sqlite:///./reva.db
HOST=0.0.0.0
PORT=8000

# Backend API URL used by the Streamlit dashboard (leave default for local dev)
API_URL=http://localhost:8000

# Public tunnel URL (used by scripts/set_twilio_webhook.py and similar tooling)
PUBLIC_BASE_URL=
