# ============================================================
# REVA — Real Estate Voice Agent
# Production Environment Variables Template
# Copy this file to .env and fill in your actual values.
# ============================================================

# --- LLM API Keys ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-flash-lite-latest

# --- Database ---
DATABASE_URL=sqlite:///./reva.db

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- TTS (Phase 2) ---
# Directory where gTTS audio files are cached. Created automatically at startup.
AUDIO_CACHE_DIR=data/audio_cache
# Timeout (seconds) before TTS degrades to browser fallback
TTS_TIMEOUT_SECONDS=5

# --- Public URL (for ngrok / Render / HuggingFace) ---
PUBLIC_BASE_URL=https://your-deployment-url-here

# --- Twilio (NOT used in deployment — left for reference only) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
